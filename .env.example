# Ключ Geoapify для поиска мест через REST и MCP.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
INTERNAL_API_TOKEN=
# Корень файлов для Python-ядра ноутбука. Относительные пути считаются от корня репозитория.
REELS_VIDEO_DIR=data/raw
# Пять путей относительно REELS_VIDEO_DIR в формате JSON.
REELS_VIDEO_FILES='["reel-01.mp4","reel-02.mp4","reel-03.mp4","reel-04.mp4","reel-05.mp4"]'
REELS_OUTPUT_DIR=outputs/gemma_frames
# Имя модели для скачивания либо путь к каталогу с весами на машине ядра.
GEMMA_MODEL=google/embeddinggemma-2
GEMMA_CPU_THREADS=3
# Опционально для переноса файлов на сервер по SSH.
REELS_SSH_HOST=
REELS_REMOTE_ROOT=

# Только для необязательного src/run_gemma_notebook.sh с уже подготовленными томами.
# Для этого режима задайте выше REELS_VIDEO_DIR=/media и GEMMA_MODEL=/weights.
REELS_HOST_VIDEO_DIR=
GEMMA_CPU_IMAGE=
GEMMA_ENV_VOLUME=
GEMMA_MODEL_VOLUME=

# Orchestrator: отдельная база проекта и существующая Kafka. Без реальных учётных данных.
DOCKER_NETWORK=
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=reels_router
PG_USER=reels_router
PG_PASSWORD=
PG_SSLMODE=require
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_FILE=
KAFKA_TOPIC_MEDIA=reels.media.commands.v1
KAFKA_TOPIC_EVENTS=reels.pipeline.events.v1
KAFKA_GROUP_MEDIA=reels-media
KAFKA_GROUP_COORDINATOR=reels-coordinator
KAFKA_GROUP_FRAMES=reels-frames
KAFKA_TOPIC_FRAMES=reels.frames.commands.v1
KAFKA_TOPIC_ASR=reels.asr.commands.v1
KAFKA_GROUP_ASR=reels-asr
KAFKA_TOPIC_VLM=reels.vlm.commands.v1
KAFKA_GROUP_VLM=reels-vlm
KAFKA_TOPIC_LLM=reels.llm.commands.v1
KAFKA_GROUP_LLM=reels-llm
KAFKA_TOPIC_GEO=reels.geo.commands.v1
KAFKA_GROUP_GEO=reels-geo
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=reels-router
SCRATCH_DIR=/tmp
MAX_VIDEO_SECONDS=180
MAX_DOWNLOAD_BYTES=104857600
STAGE_TIMEOUT_SECONDS=600
INSTAGRAM_COOKIES_FILE=
FRAME_TOP_K=10
# ASR и VLM подключаются при заполнении всех четырёх полей соответствующего провайдера.
ASR_PROVIDER=
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_MAX_BYTES=25000000
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
VLM_PROVIDER=
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
