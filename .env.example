# Корень файлов для Python-ядра ноутбука. Относительные пути считаются от корня репозитория.
REELS_VIDEO_DIR=data/raw
# Пять путей относительно REELS_VIDEO_DIR в формате JSON.
REELS_VIDEO_FILES='["reel-01.mp4","reel-02.mp4","reel-03.mp4","reel-04.mp4","reel-05.mp4"]'
REELS_OUTPUT_DIR=outputs/gemma_frames
# Имя модели для скачивания либо путь к каталогу с весами на машине ядра.
GEMMA_MODEL=google/embeddinggemma-2
GEMMA_CPU_THREADS=3
# Опционально для переноса файлов на сервер по SSH.
REELS_SSH_HOST=
REELS_REMOTE_ROOT=

# Только для необязательного src/run_gemma_notebook.sh с уже подготовленными томами.
# Для этого режима задайте выше REELS_VIDEO_DIR=/media и GEMMA_MODEL=/weights.
REELS_HOST_VIDEO_DIR=
GEMMA_CPU_IMAGE=
GEMMA_ENV_VOLUME=
GEMMA_MODEL_VOLUME=
